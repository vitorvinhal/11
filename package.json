{
  "name": "11",
  "version": "2.10.7-alpha",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter @11/shared build && pnpm --filter @11/ia build && pnpm --filter @11/web build",
    "build:web": "pnpm --filter @11/web build",
    "build:packages": "pnpm --filter @11/shared build && pnpm --filter @11/ia build && pnpm --filter @11/api build && pnpm --filter @11/cli build",
    "dev:api": "pnpm --filter @11/api start",
    "dev:desktop": "pnpm --filter @11/desktop dev",
    "dev:mobile": "pnpm --filter @11/mobile start",
    "dev:web": "pnpm --filter @11/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "version:patch": "node scripts/version.js patch",
    "version:minor": "node scripts/version.js minor",
    "version:major": "node scripts/version.js major",
    "version:rc": "node scripts/version.js patch --release rc",
    "version:show": "node -e \"const j=require('./apps/web/public/version.json');console.log(j.version)\""
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-wol": "^0.1.1",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-rate-limit": "^6.0.2",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8",
    "husky": "^9.1.7",
    "jest": "^29",
    "lint-staged": "^17.5.1",
    "pnpm": "^8",
    "prettier": "^3",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "node-pty"
      ]
    }
  }
}
