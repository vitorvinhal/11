# ==== WEB (apps/web/.env.local) ====
# Supabase (obrigatório para auth + persistência)
NEXT_PUBLIC_SUPABASE_URL=https://uacqekmejviqddrbnfhg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_xxx

# STT — transcrição de voz (rota /api/stt)
ELEVENLABS_KEY=

# TTS — voz da 11 (rota /api/tts)
FISH_API_KEY=
FISH_VOICE_ID=

# Provedores de LLM (rota /api/chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# 9Router — gateway unificado (modelo "9router" e análise de mídia)
# ENDPOINT local (9Router rodando no seu PC); TUNNEL público para acesso remoto.
9ROUTER_ENDPOINT=http://localhost:20128
9ROUTER_TUNNEL=https://exemplo.abc-tunnel.us
9ROUTER_TOKEN=
# Combo padrão — modelos que funcionam: kr/glm-5, kr/claude-sonnet-4.5, gemini/gemini-3.6-flash
9ROUTER_MODEL=kr/glm-5
# Combos de fallback quando o principal retorna 429 (quota) ou 404
9ROUTER_FALLBACK_MODELS=kr/glm-5,kr/claude-sonnet-4.5,gemini/gemini-3.6-flash

# OAuth Google (conectores)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_URL=http://localhost:3000

# Embeddings — dimensão unificada (768 = Gemini text-embedding-004 free tier)
EMBEDDING_DIMS=768

# Rate limiting (rota /api/code, /api/terminal)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Deploy governance (broker de tokens)
DEPLOY_TOKEN_TTL_MS=300000
DEPLOY_CIRCUIT_MAX_PER_HOUR=5

# Bridge / Terminal / file tool whitelist
BRIDGE_ALLOWED_DIRS=
BRIDGE_MAX_FILE_BYTES=10485760

# Utilitários
PNPM_BIN=pnpm

# Cloudflare Tunnel
CF_TUNNEL_TOKEN=
CF_TUNNEL_URL=
CF_SERVICE_TOKEN=

# Supabase CI/CD
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Router9 porta dedicada (desocupa 3001 p/ pc-agent)
ROUTER9_PORT=3002

# ==== DESKTOP (apps/desktop/src-tauri/.env ou processo) ====
# Autenticação do PC Agent / router9
JWT_SECRET=change-me
PC_AGENT_PORT=3001
INFERENCE_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000
ELEVENLABS_KEY=
9ROUTER_ENDPOINT=http://localhost:20128
9ROUTER_TUNNEL=https://exemplo.abc-tunnel.us
9ROUTER_TOKEN=
9ROUTER_MODEL=kr/glm-5
9ROUTER_FALLBACK_MODELS=kr/glm-5,kr/claude-sonnet-4.5,gemini/gemini-3.6-flash